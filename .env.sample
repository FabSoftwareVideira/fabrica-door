# Configurações gerais
SITE_NAME="Fábrica de Software - IFC Videira"
SITE_URL=https://fabrica.labia.ifc.edu.br

# Outras configurações
EMAIL_FABRICA=fabricadesoftware.videira@ifc.edu.br
GOOGLE_ANALYTICS=
API_KEY=chave_de_api_do_servico_de_email

# Configurações de rede e container
PORT=8000
NODE_ENV=production
LOG_LEVEL=INFO

# Tag da imagem Docker (usada em docker-compose.prod.yml)
IMAGE_TAG=latest

# ----------------------------------------------------------------
# Banco de dados PostgreSQL
# ----------------------------------------------------------------
PGHOST=db
PGPORT=5432
PGDATABASE=fabrica_door
PGUSER=postgres
PGPASSWORD=postgres
# Descomente para SSL em produção:
# PGSSLMODE=require

# ----------------------------------------------------------------
# Autenticação JWT
# ----------------------------------------------------------------
# Gere um segredo forte em produção, ex: openssl rand -hex 64
JWT_SECRET=mude_em_producao_use_um_valor_secreto_longo
JWT_EXPIRES_IN=8h

# Área administrativa (/admin) e autenticação via Google OAuth
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# ----------------------------------------------------------------
# Login automático em modo dev (sem Google OAuth)
# Defina como "true" para entrar direto como dev@localhost
# NUNCA ative em produção — é ignorado quando NODE_ENV=production
# ----------------------------------------------------------------
# DEV_AUTO_LOGIN=true